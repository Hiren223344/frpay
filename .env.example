# Copy to .env and fill in. Never commit the real file.

HTTP_ADDR=:8080
MIGRATIONS_DIR=migrations

POSTGRES_DSN=postgres://frenixpay:frenixpay@localhost:5432/frenixpay?sslmode=disable
REDIS_ADDR=127.0.0.1:6379
REDIS_DB=0

# 32 random bytes, base64-encoded. Encrypts merchant api_secret and
# webhook_secret at rest. Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Watch-only extended public keys. Export these from an OFFLINE signer
# at the *change* level of the BIP44 path — this service must never see
# the corresponding private key or a hardened-path xprv:
#   TRON: m/44'/195'/0'/0  (coin type 195)
#   EVM:  m/44'/60'/0'/0   (coin type 60; shared by Ethereum/BSC/Polygon)
MASTER_XPUB_TRON=
MASTER_XPUB_EVM=

ORDER_EXPIRY=20m
MERCHANT_RATE_LIMIT_PER_MINUTE=120
PUBLIC_RATE_LIMIT_PER_MINUTE=60

# --- TRON ---
TRON_ENABLED=true
TRON_API_URL=https://api.trongrid.io
# Comma-separated fallback endpoints tried in order if the primary fails.
TRON_FALLBACK_API_URLS=
# Optional but recommended: free at https://www.trongrid.io — raises rate limits.
TRON_API_KEY=
TRON_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
TRON_POLL_INTERVAL=5s
TRON_REQUIRED_CONFIRMATIONS=20

# --- Ethereum ---
ETHEREUM_ENABLED=false
ETHEREUM_RPC_URL=https://eth.llamarpc.com
ETHEREUM_FALLBACK_RPC_URLS=
ETHEREUM_USDT_CONTRACT=0xdAC17F958D2ee523a2206206994597C13D831ec
ETHEREUM_POLL_INTERVAL=15s
ETHEREUM_REQUIRED_CONFIRMATIONS=12
ETHEREUM_LOGS_BATCH_BLOCKS=2000

# --- BSC ---
BSC_ENABLED=false
BSC_RPC_URL=https://bsc-dataseed.binance.org
BSC_FALLBACK_RPC_URLS=
BSC_USDT_CONTRACT=0x55d398326f99059fF775485246999027B3197955
BSC_POLL_INTERVAL=5s
BSC_REQUIRED_CONFIRMATIONS=15
BSC_LOGS_BATCH_BLOCKS=2000

# --- Polygon ---
POLYGON_ENABLED=false
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_FALLBACK_RPC_URLS=
POLYGON_USDT_CONTRACT=0xc2132D05D31c914a87C6611C10748AEb04B58e8F
POLYGON_POLL_INTERVAL=5s
# Polygon finality assumption: 128 blocks (~4-5min) tracks Polygon PoS
# checkpointing to Ethereum; lower this if you're comfortable trusting
# Heimdall/Bor soft finality instead.
POLYGON_REQUIRED_CONFIRMATIONS=128
POLYGON_LOGS_BATCH_BLOCKS=2000
