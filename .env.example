# Copy to .env and fill in. Never commit the real file.

HTTP_ADDR=:8080
MIGRATIONS_DIR=migrations

POSTGRES_DSN=postgres://frenixpay:frenixpay@localhost:5432/frenixpay?sslmode=disable
REDIS_ADDR=127.0.0.1:6379
REDIS_DB=0

# Single shared secret guarding POST /v1/orders. Generate with:
#   openssl rand -hex 32
# Never expose this to a browser — order creation is server-to-server only.
API_KEY=

ORDER_EXPIRY=20m
ORDERS_RATE_LIMIT_PER_MINUTE=60
PUBLIC_RATE_LIMIT_PER_MINUTE=60

# How far an on-chain amount may differ from an order's expected_amount
# and still count as an exact match (rounding/precision slack), in USD.
AMOUNT_TOLERANCE_USD=0.02

# How far short of expected_amount a transfer may fall and still be
# attributed to that order as "underpaid" rather than logged as a fully
# unmatched payment. 50 = a transfer for as little as 50% of the
# expected amount still counts as an underpayment attempt on that order.
UNDERPAYMENT_MAX_GAP_PERCENT=50

# Every order's expected_amount is base_amount_usd plus a random offset
# of this many ten-thousandths of a dollar (1-99 = $0.0001-$0.0099),
# retried on collision with another pending order on the same chain.
EXPECTED_AMOUNT_OFFSET_MIN=1
EXPECTED_AMOUNT_OFFSET_MAX=99
MAX_AMOUNT_COLLISION_RETRIES=20

# --- TRON ---
# This service only ever reads public on-chain data against ADDRESS —
# it holds no key material for any chain, watch-only or otherwise.
TRON_ENABLED=true
TRON_ADDRESS=
TRON_API_URL=https://api.trongrid.io
# Comma-separated fallback endpoints tried in order if the primary fails.
TRON_FALLBACK_API_URLS=
# Optional but recommended: free at https://www.trongrid.io — raises rate limits.
TRON_API_KEY=
TRON_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
TRON_POLL_INTERVAL=5s
TRON_REQUIRED_CONFIRMATIONS=20

# --- TON ---
# Uses toncenter.com's v3 jetton-transfers API — see docs.md's "Chain
# watchers" section for a caveat on this one: it was built without live
# access to verify toncenter's current API shape, so double-check it
# against a real testnet transfer before going live.
TON_ENABLED=false
TON_ADDRESS=
TON_API_URL=https://toncenter.com/api/v3
TON_FALLBACK_API_URLS=
# Optional: raises toncenter's public rate limits.
TON_API_KEY=
TON_USDT_JETTON_MASTER=EQCxE6mUtQJKFnGfaROTKOt1lZbDiiX1kCixRv7Nw2Id_sDs
TON_POLL_INTERVAL=8s
# TON has no simple block-count confirmations; this is elapsed time
# (seconds) divided by an assumed ~5s block interval.
TON_REQUIRED_CONFIRMATIONS=5

# --- Polygon ---
POLYGON_ENABLED=false
POLYGON_ADDRESS=
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_FALLBACK_RPC_URLS=
POLYGON_USDT_CONTRACT=0xc2132D05D31c914a87C6611C10748AEb04B58e8F
POLYGON_POLL_INTERVAL=5s
# Polygon finality assumption: 128 blocks (~4-5min) tracks Polygon PoS
# checkpointing to Ethereum; lower this if you're comfortable trusting
# Heimdall/Bor soft finality instead.
POLYGON_REQUIRED_CONFIRMATIONS=128
POLYGON_LOGS_BATCH_BLOCKS=2000

# --- BSC ---
# Can use the same 0x address as Polygon (same secp256k1 address format);
# they're differentiated by RPC URL and USDT contract, not by address.
BSC_ENABLED=false
BSC_ADDRESS=
BSC_RPC_URL=https://bsc-dataseed.binance.org
BSC_FALLBACK_RPC_URLS=
BSC_USDT_CONTRACT=0x55d398326f99059fF775485246999027B3197955
BSC_POLL_INTERVAL=5s
BSC_REQUIRED_CONFIRMATIONS=15
BSC_LOGS_BATCH_BLOCKS=2000
